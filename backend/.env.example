# Copy to .env and fill in. The app boots without an LLM key using a stub
# provider, but natural-language editing needs a configured provider.

ADMIN_PASSWORD=changeme
SESSION_SECRET=please-change-this-to-a-long-random-string

# LLM layer. Provider choices:
# - openai: official OpenAI Responses API
# - openai_compatible: OpenAI-compatible Chat Completions API
# - anthropic: legacy Claude provider, if the anthropic package is installed
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5
LLM_ENDPOINT=responses
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Example for OpenAI-compatible providers:
# LLM_PROVIDER=openai_compatible
# LLM_ENDPOINT=chat
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=...

DATABASE_URL=sqlite:///./syllabus.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
